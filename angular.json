{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "medical-multitenant-platform": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/bootstrap-italia/dist",
                "output": "/bootstrap-italia/dist"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/design-angular-kit/assets/i18n",
                "output": "/bootstrap-italia/i18n/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/bootstrap-italia/dist/fonts",
                "output": "/bootstrap-italia/dist/fonts"
              }
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            }
          },
          "configurations": {
            "production": {
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "integration": {
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "staging": {
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "admin/production": {
              "browser": "src/main.admin.ts",
              "styles": ["src/app/admin/style/styles.scss"],
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all"
            },
            "admin/integration": {
              "browser": "src/main.admin.ts",
              "styles": ["src/app/admin/style/styles.scss"],
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all"
            },
            "admin/staging": {
              "browser": "src/main.admin.ts",
              "styles": ["src/app/admin/style/styles.scss"],
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all"
            },
            "admin/development": {
              "browser": "src/main.admin.ts",
              "styles": ["src/app/admin/style/styles.scss"],
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/bootstrap-italia/dist",
                  "output": "/bootstrap-italia/dist"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/design-angular-kit/assets/i18n",
                  "output": "/bootstrap-italia/i18n/"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "medical-multitenant-platform:build:production"
            },
            "development": {
              "buildTarget": "medical-multitenant-platform:build:development"
            },
            "admin/production": {
              "buildTarget": "medical-multitenant-platform:build:admin/production"
            },
            "admin/development": {
              "buildTarget": "medical-multitenant-platform:build:admin/development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
