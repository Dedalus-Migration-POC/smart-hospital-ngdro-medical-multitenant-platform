{
  "topbar": {
    "height": "48px",
    "position": {
      "type": "sticky"
    },
    "background": {
      "fill": {
        "hex": "#00204D"
      }
    },
    "areas": {
      "layout": {
        "direction": "row",
        "gap": "gap-2",
        "align": "center",
        "justify": "between",
        "wrap": "wrap"
      },
      "start": {
        "layout": {
          "direction": "column",
          "gap": "gap-0"
        },
        "items": [
          {
            "id": "topbar-text-1",
            "type": "LINK",
            "enabled": true,
            "props": {
              "text": {
                "it": "Servizio sanitario digitale",
                "en": "Digital Services"
              },
              "description": {
                "it": "Apri external link",
                "en": "Open external link"
              },
              "url": "https://www.dedalus.com/italy/it/",
              "external": true,
              "style": {
                "textStyle": {
                  "fontSize": "sm",
                  "fontWeight": "semibold",
                  "color": {
                    "palette": "white"
                  }
                },
                "hover": {
                  "textDecorationThickness": "1px"
                }
              }
            }
          }
        ]
      },
      "end": {
        "layout": {
          "direction": "row",
          "gap": "gap-3"
        },
        "items": [
          {
            "id": "topbar-translate-1",
            "type": "SELECT_LANG",
            "enabled": true,
            "props": {
              "supportedLanguages": ["it", "en"],
              "arialabel": "Lingua selezionata:",
              "color": "white"
            }
          },
          {
            "id": "user-menu",
            "type": "USER_DROPDOWN_MENU",
            "enabled": true,
            "props": {
              "button": {
                "loggedInUser": {
                  "padding": {
                    "all": "0px"
                  },
                  "textStyle": {
                    "textDecoration": "none",
                    "textTransform": "capitalize",
                    "fontSize": "md",
                    "color": {
                      "palette": "white"
                    }
                  },
                  "icon": {
                    "type": "font-awesome",
                    "name": "fa-regular fa-user",
                    "color": {
                      "palette": "white"
                    },
                    "fontSize": "14px"
                  }
                },
                "login": {
                  "text": {
                    "text": {
                      "it": "Accedi",
                      "en": "Login"
                    },
                    "color": {
                      "palette": "white"
                    },
                    "margin": {
                      "left": ".625rem"
                    }
                  },
                  "icon": {
                    "type": "font-awesome",
                    "name": "fa-regular fa-circle-user",
                    "fontSize": "1.5rem",
                    "color": {
                      "palette": "white"
                    },
                    "margin": {
                      "all": "0px"
                    }
                  }
                }
              },
              "caret": {
                "show": false
              },
              "dropdownMenu": {
                "background": {
                  "fill": {
                    "palette": "light"
                  }
                },
                "border": {
                  "radius": "4px"
                },
                "items": [
                  {
                    "id": "profile",
                    "padding": {
                      "y": "4px",
                      "x": "12px"
                    },
                    "icon": {
                      "type": "font-awesome",
                      "name": "fa-regular fa-user",
                      "color": {
                        "palette": "black"
                      }
                    },
                    "text": {
                      "text": {
                        "it": "Profilo",
                        "en": "Profile"
                      },
                      "color": {
                        "palette": "black"
                      }
                    },
                    "nameFunction": "gotoUserProfile"
                  },
                  {
                    "id": "logout",
                    "padding": {
                      "y": "4px",
                      "x": "12px"
                    },
                    "icon": {
                      "type": "font-awesome",
                      "name": "fa-solid fa-arrow-right-from-bracket",
                      "color": {
                        "palette": "black"
                      }
                    },
                    "text": {
                      "text": {
                        "it": "Esci",
                        "en": "Logout"
                      },
                      "color": {
                        "palette": "black"
                      }
                    },
                    "nameFunction": "logout"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "main": {
    "position": {
      "type": "sticky"
    },
    "background": {
      "fill": {
        "hex": "#003580"
      }
    },

    "areas": {
      "layout": {
        "direction": "row",
        "gap": "gap-3",
        "wrap": "wrap",
        "align-items": "center"
      },
      "start": {
        "layout": {
          "direction": "row",
          "gap": "gap-3",
          "align": "center",
          "wrap": "nowrap",
          "grow": "grow-1"
        },
        "items": [
          {
            "id": "header-logo",
            "type": "IMAGE_BLOCK",
            "enabled": true,
            "props": {
              "id": "hero-image",
              "layout": {
                "direction": "column-reverse",
                "gap": "gap-2",
                "align": "center"
              },
              "image": {
                "type": "base64",
                "value": "data:image/svg+xml;base64,",
                "decorative": false,
                "className": "img-logo",
                "alt": {
                  "it": "Healthcare",
                  "en": "Healthcare"
                },
                "ariaLabel": {
                  "it": "Healthcare",
                  "en": "Healthcare"
                },
                "tooltip": {
                  "enabled": true,
                  "tooltipLabel": {
                    "it": "Tooltip Label",
                    "en": "Tooltip Label"
                  },
                  "tooltipClassName": ""
                }
              },
              "clickable": true,
              "action": {
                "type": "externalLink",
                "url": "https://google.com",
                "target": "_blank"
              }
            }
          }
        ]
      },
      "end": {
        "layout": {
          "direction": "row",
          "justify": "end",
          "align": "center",
          "wrap": "nowrap"
        },
        "items": [
          {
            "id": "header-socials",
            "type": "SOCIAL",
            "enabled": true,
            "props": {
              "showLabel": false,
              "className": "d-none d-md-flex",
              "labelStyle": {
                "fontSize": "sm",
                "fontWeight": "normal",
                "color": {
                  "palette": "white"
                },
                "textDecoration": "none",
                "textTransform": "capitalize"
              },
              "layout": {
                "direction": "row",
                "gap": "gap-3",
                "align": "center"
              },
              "title": {
                "text": {
                  "it": "Seguici su",
                  "en": "Follow us"
                },
                "fontSize": "md",
                "fontWeight": "normal",
                "color": {
                  "palette": "white"
                }
              },
              "socials": [
                {
                  "id": "fb",
                  "label": {
                    "it": "Facebook",
                    "en": "Facebook"
                  },
                  "ariaLabel": {
                    "it": "Facebook (si apre in una nuova scheda)",
                    "en": "Facebook (open new tab)"
                  },
                  "icon": {
                    "type": "font-awesome",
                    "name": "fa-brands fa-facebook-f",
                    "fontSize": "1.25rem"
                  },
                  "url": "https://www.facebook.com",
                  "target": "_blank",
                  "margin": {
                    "right": "0.5rem"
                  }
                },
                {
                  "id": "instagram",
                  "label": {
                    "it": "Instagram",
                    "en": "Instagram"
                  },
                  "ariaLabel": {
                    "it": "Instagram (si apre in una nuova scheda)",
                    "en": "Instagram (open new tab)"
                  },
                  "icon": {
                    "type": "font-awesome",
                    "name": "fa-brands fa-instagram",
                    "fontSize": "1.25rem"
                  },
                  "url": "https://www.instagram.com",
                  "target": "_blank",
                  "margin": {
                    "right": "0.5rem"
                  }
                },
                {
                  "id": "in",
                  "label": {
                    "it": "Linkedin",
                    "en": "Linkedin"
                  },
                  "ariaLabel": {
                    "it": "Linkedin (si apre in una nuova scheda)",
                    "en": "Linkedin (open new tab)"
                  },
                  "icon": {
                    "type": "font-awesome",
                    "name": "fa-brands fa-linkedin-in",
                    "fontSize": "1.25rem"
                  },
                  "url": "https://www.linkedin.com",
                  "target": "_blank"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "bottombar": {
    "height": "48px",
    "position": {
      "type": "sticky"
    },
    "background": {
      "fill": {
        "hex": "#003580"
      }
    },
    "className": "bottombar-custom",
    "areas": {
      "layout": {
        "direction": "row",
        "gap": "gap-2",
        "justify": "between",
        "wrap": "wrap"
      },
      "start": {
        "layout": {
          "direction": "row",
          "gap": "gap-3",
          "align": "center",
          "wrap": "nowrap"
        },
        "items": []
      },
      "center": {
        "layout": {
          "direction": "row",
          "gap": "gap-2",
          "align": "center",
          "wrap": "nowrap"
        },
        "items": []
      },
      "end": {
        "layout": {
          "direction": "row",
          "align": "center",
          "wrap": "nowrap"
        },
        "items": [
          {
            "id": "footer-link",
            "type": "LINK",
            "enabled": true,
            "props": {
              "text": {
                "it": "Home link",
                "en": "Home link"
              },
              "url": "/",
              "external": false,
              "style": {
                "textStyle": {
                  "fontSize": "md",
                  "fontWeight": "semibold",
                  "color": {
                    "palette": "white"
                  },
                  "padding": {
                    "x": "24px",
                    "y": "12px"
                  }
                }
              }
            }
          },
          {
            "id": "footer-link-2",
            "type": "LINK",
            "enabled": true,
            "props": {
              "text": {
                "it": "Login",
                "en": "Login"
              },
              "url": "/login",
              "external": false,
              "style": {
                "textStyle": {
                  "fontSize": "md",
                  "fontWeight": "semibold",
                  "color": {
                    "palette": "white"
                  },
                  "padding": {
                    "x": "24px",
                    "y": "12px"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
