{
  "id": "/booking-a4h/appointments/details",
  "name": "pages.booking-a4h-appointments-details.name",
  "route": "/booking-a4h/appointments/details",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": { "fill": { "hex": "#e6e8ea" } },
    "itemsStyle": { "color": { "hex": "#333333" } },
    "title": {
      "text": "pages.booking-a4h-appointments-details.breadcrumb.title"
    },
    "items": [
      {
        "name": "pages.booking-a4h-appointments-details.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "pages.booking-a4h-appointments-details.breadcrumb.items.appointments",
        "routerLink": "/booking-a4h/appointments"
      },
      {
        "name": "pages.booking-a4h-appointments-details.breadcrumb.items.details",
        "routerLink": "/booking-a4h/appointments"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "center": {
          "items": [
            {
              "id": "appointment-details-card",
              "type": "SERVICE_CARDS",
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-10 col-xl-8",
                "itemsLayout": { "direction": "row", "gap": "gap-2" },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "center",
                  "gap": "gap-4"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "padding": { "x": "2rem", "y": "1.5rem" },
                    "titleSubtitle": {
                      "title": { "key": "description", "fontSize": "lg", "margin": "mb-3" }
                    },
                    "fields": [
                      {
                        "key": "paymentStatusForDisplay",
                        "type": "badge",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.payment-status.label"
                        },
                        "badgeMap": {
                          "PAID": {
                            "text": "pages.booking-a4h-appointments-details.payment-status.badgeMap.PAID",
                            "color": { "palette": "success" }
                          },
                          "TO_PAY": {
                            "text": "pages.booking-a4h-appointments-details.payment-status.badgeMap.TO_PAY",
                            "color": { "palette": "warning" }
                          }
                        }
                      },
                      {
                        "key": "code",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.code-label"
                        }
                      },
                      {
                        "key": "physician",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.physician-label"
                        }
                      },
                      {
                        "key": "scheduledOn",
                        "type": "date",
                        "format": "dd/MM/yyyy - HH:mm",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.scheduled-on-label"
                        }
                      },
                      {
                        "key": "address",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.address-label"
                        }
                      },
                      {
                        "key": "locationDetails.department",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.department-label"
                        }
                      },
                      {
                        "key": "locationDetails.floor",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.floor-label"
                        }
                      },
                      {
                        "key": "locationDetails.waitingRoom",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.waiting-room-label"
                        }
                      },
                      {
                        "key": "locationDetails.examinationRoom",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "pages.booking-a4h-appointments-details.examination-room-label"
                        }
                      },

                      {
                        "key": "hint",
                        "type": "text",
                        "hideIfEmpty": true,
                        "margin": { "top": "1rem" },
                        "valueStyle": {
                          "fontSize": "sm",
                          "fontWeight": "semibold",
                          "color": { "palette": "primary" }
                        },
                        "label": { "text": "pages.booking-a4h-appointments-details.hint-label" },
                        "valueMap": {
                          "NOT-EDITABLE": {
                            "text": "pages.booking-a4h-appointments-details.hint-value"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "preparation",
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "label": {
                          "text": "pages.booking-a4h-appointments-details.preparation-label"
                        },
                        "callback": { "nameFunction": "downloadVademecum" },
                        "hideIf": [{ "key": "linkNote", "operator": "empty" }],
                        "hideMessage": {
                          "text": "pages.booking-a4h-appointments-details.preparation-hide-message"
                        }
                      },
                      {
                        "key": "edit",
                        "type": "callback",
                        "renderAs": "button",
                        "label": {
                          "text": "pages.booking-a4h-appointments-details.actions.edit"
                        },
                        "callback": { "nameFunction": "editAppointment" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [{ "key": "editDisabled", "operator": "eq", "value": true }]
                      },
                      {
                        "key": "delete",
                        "type": "callback",
                        "renderAs": "button",
                        "palette": "danger",
                        "outline": true,
                        "label": {
                          "text": "pages.booking-a4h-appointments-details.actions.delete"
                        },
                        "callback": { "nameFunction": "deleteAppointment" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [{ "key": "editDisabled", "operator": "eq", "value": true }]
                      },
                      {
                        "key": "checkIn",
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "label": {
                          "text": "pages.booking-a4h-appointments-details.actions.check-in"
                        },
                        "callback": { "nameFunction": "requestCheckIn" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [
                          { "key": "checkInDisabled", "operator": "eq", "value": true }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "appointmentError",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "jsonConfig.default.pages.booking-a4h-appointments-details.message.error.image.alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "jsonConfig.default.pages.booking-a4h-appointments-details.message.error.text.title.text",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "jsonConfig.default.pages.booking-a4h-appointments-details.message.error.text.subTitle.text",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "appointmentNotFound",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "jsonConfig.default.pages.booking-a4h-appointments-details.message.notFound.image.alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "jsonConfig.default.pages.booking-a4h-appointments-details.message.notFound.text.title.text",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "warning" },
          "lineHeight": "normal"
        }
      }
    }
  }
}
