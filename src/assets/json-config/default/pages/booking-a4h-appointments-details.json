{
  "id": "/booking-a4h/appointments/details",
  "name": {
    "it": "Dettaglio appuntamento",
    "en": "Appointment details"
  },
  "route": "/booking-a4h/appointments/details",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": { "fill": { "hex": "#e6e8ea" } },
    "itemsStyle": { "color": { "hex": "#333333" } },
    "title": {
      "text": {
        "it": "Dettaglio prenotazione {{service}}",
        "en": "Appointment details – {{service}}"
      }
    },
    "items": [
      {
        "name": { "it": "Home", "en": "Home" },
        "routerLink": "/"
      },
      {
        "name": { "it": "Appuntamenti", "en": "Appointments" },
        "routerLink": "/booking-a4h/appointments"
      },
      {
        "name": { "it": "Dettaglio", "en": "Details" },
        "routerLink": "/booking-a4h/appointments"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "center": {
          "items": [
            {
              "id": "appointment-details-card",
              "type": "SERVICE_CARDS",
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-10 col-xl-8",
                "itemsLayout": { "direction": "row", "gap": "gap-2" },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "center",
                  "gap": "gap-4"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "padding": { "x": "2rem", "y": "1.5rem" },
                    "titleSubtitle": {
                      "title": { "key": "description", "fontSize": "lg", "margin": "mb-3" }
                    },
                    "fields": [
                      {
                        "key": "paymentStatusForDisplay",
                        "type": "badge",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Stato del pagamento", "en": "Payment status" }
                        },
                        "badgeMap": {
                          "PAID": {
                            "text": { "it": "Pagato", "en": "Paid" },
                            "color": { "palette": "success" }
                          },
                          "TO_PAY": {
                            "text": { "it": "Da pagare", "en": "Unpaid" },
                            "color": { "palette": "warning" }
                          }
                        }
                      },
                      {
                        "key": "code",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Identificativo appuntamento", "en": "Appointment ID" }
                        }
                      },
                      {
                        "key": "physician",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Medico", "en": "Physician" }
                        }
                      },
                      {
                        "key": "scheduledOn",
                        "type": "date",
                        "format": "dd/MM/yyyy - HH:mm",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Data e ora", "en": "Date and time" }
                        }
                      },
                      {
                        "key": "address",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Presidio", "en": "Location" }
                        }
                      },
                      {
                        "key": "locationDetails.department",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Ambulatorio", "en": "Clinic" }
                        }
                      },
                      {
                        "key": "locationDetails.floor",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": { "fontWeight": "bold", "text": { "it": "Piano", "en": "Floor" } }
                      },
                      {
                        "key": "locationDetails.waitingRoom",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Sala d'aspetto", "en": "Waiting room" }
                        }
                      },
                      {
                        "key": "locationDetails.examinationRoom",
                        "type": "text",
                        "hideIfEmpty": true,
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": { "it": "Sala ambulatorio", "en": "Examination room" }
                        }
                      },

                      {
                        "key": "hint",
                        "type": "text",
                        "hideIfEmpty": true,
                        "margin": { "top": "1rem" },
                        "valueStyle": {
                          "fontSize": "sm",
                          "fontWeight": "semibold",
                          "color": { "palette": "primary" }
                        },
                        "label": { "text": { "it": "", "en": "" } },
                        "valueMap": {
                          "NOT-EDITABLE": {
                            "text": {
                              "it": "Non è possibile modificare o eliminare questa prenotazione. Contattare il CUP della struttura per maggiori informazioni.",
                              "en": "This booking cannot be modified or cancelled. Please contact the facility's CUP for more information."
                            }
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "preparation",
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "label": {
                          "text": { "it": "Download Vademecum", "en": "Download Guidelines" }
                        },
                        "callback": { "nameFunction": "downloadVademecum" },
                        "hideIf": [{ "key": "linkNote", "operator": "empty" }],
                        "hideMessage": {
                          "text": {
                            "it": "Documento non disponibile",
                            "en": "Document unavailable"
                          }
                        }
                      },
                      {
                        "key": "edit",
                        "type": "callback",
                        "renderAs": "button",
                        "label": {
                          "text": {
                            "it": "Modifica data appuntamento",
                            "en": "Change appointment date"
                          }
                        },
                        "callback": { "nameFunction": "editAppointment" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [{ "key": "editDisabled", "operator": "eq", "value": true }]
                      },
                      {
                        "key": "delete",
                        "type": "callback",
                        "renderAs": "button",
                        "palette": "danger",
                        "outline": true,
                        "label": {
                          "text": { "it": "Cancella appuntamento", "en": "Cancel appointment" }
                        },
                        "callback": { "nameFunction": "deleteAppointment" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [{ "key": "editDisabled", "operator": "eq", "value": true }]
                      },
                      {
                        "key": "checkIn",
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "label": {
                          "text": {
                            "it": "Procedi con l'accettazione",
                            "en": "Proceed with check-in"
                          }
                        },
                        "callback": { "nameFunction": "requestCheckIn" },
                        "hideIf": [{ "key": "isDone", "operator": "eq", "value": true }],
                        "disabledIf": [
                          { "key": "checkInDisabled", "operator": "eq", "value": true }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "appointmentError",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": { "it": "Errore", "en": "Error" },
        "height": "150px"
      },
      "text": {
        "title": {
          "text": { "it": "Errore", "en": "Error" },
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": {
            "it": "Si è verificato un errore durante il recupero dell'appuntamento. Riprova più tardi.",
            "en": "An error occurred while fetching the appointment. Please try again later."
          },
          "fontSize": "md",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "appointmentNotFound",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": { "it": "Appuntamento non trovato", "en": "Appointment not found" },
        "height": "150px"
      },
      "text": {
        "title": {
          "text": { "it": "Appuntamento non trovato", "en": "Appointment not found" },
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "warning" },
          "lineHeight": "normal"
        }
      }
    }
  }
}
