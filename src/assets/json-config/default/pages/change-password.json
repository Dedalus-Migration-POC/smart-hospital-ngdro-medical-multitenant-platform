  "sections": [
    {
      "title": { "it": "Cambio password", "en": "Change password" },
      "areas": {
        "center": {
          "items": [
            {
              "id": "change-password-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": { "direction": "column", "gap": "gap-3" },
                "fields": [
                  {
                    "id": "currentPassword",
                    "type": "password",
                    "label": { "it": "Password attuale", "en": "Current password" },
                    "required": true,
                    "layoutField": { "direction": "column" },
                    "size": { "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La password attuale è obbligatoria",
                        "en": "Current password is required"
                      }
                    }
                  },
                  {
                    "id": "newPassword",
                    "type": "password",
                    "label": { "it": "Nuova password", "en": "New password" },
                    "required": true,
                    "layoutField": { "direction": "column" },
                    "size": { "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La nuova password è obbligatoria",
                        "en": "New password is required"
                      }
                    }
                  },
                  {
                    "id": "repeatNewPassword",
                    "type": "password",
                    "label": { "it": "Ripeti nuova password", "en": "Repeat new password" },
                    "required": true,
                    "layoutField": { "direction": "column" },
                    "size": { "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      { "type": "passwordMatching", "value": "newPassword" }
                    ],
                    "errorMessages": {
                      "required": {
                        "it": "Ripeti la nuova password",
                        "en": "Repeat the new password"
                      },
                      "validateMatching": {
                        "it": "Le password non coincidono",
                        "en": "Passwords do not match"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "submitButton": { "label": { "it": "Cambia password", "en": "Change password" } },
  "messages": {
    "intro": {
      "it": "Inserisci la password attuale e scegli una nuova password.",
      "en": "Enter your current password and choose a new one."
    },
    "back": { "it": "Torna alla Home", "en": "Back to Home" }
  },
  "message": {
    "success": {
