{
  "name": "booking-a4h-appointments.name",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": { "fill": { "hex": "#e6e8ea" } },
    "itemsStyle": { "color": { "hex": "#333333" } },
    "title": { "text": "booking-a4h-appointments.breadcrumb.title" },
    "subTitle": {
      "text": "booking-a4h-appointments.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "booking-a4h-appointments.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "booking-a4h-appointments.breadcrumb.items.appointments",
        "routerLink": "/booking-a4h/appointments"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "center": {
          "items": [
            {
              "id": "appointments-cards",
              "type": "SERVICE_CARDS",
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-lg-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "satrt",
                  "gap": "gap-2"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "between",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "titleSubtitle": {
                      "title": {
                        "key": "description",
                        "fontSize": "lg",
                        "lineHeight": "sm",
                        "margin": { "bottom": "1rem" }
                      }
                    },
                    "fields": [
                      {
                        "key": "contract",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "valueMap": {
                          "SSN": { "text": "booking-a4h-appointments.fields.contract.SSN" },
                          "SOLV": {
                            "text": "booking-a4h-appointments.fields.contract.SOLV"
                          },
                          "LP": {
                            "text": "booking-a4h-appointments.fields.contract.LP"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.contract.label"
                        }
                      },
                      {
                        "key": "scheduledOn",
                        "type": "date",
                        "format": "EEEE dd MMM yyyy - HH:mm",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "valueStyle": { "fontWeight": "bold" },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.scheduledOn.label"
                        }
                      },
                      {
                        "key": "paymentStatus",
                        "type": "badge",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.paymentStatus.label"
                        },
                        "badgeMap": {
                          "PAID": {
                            "text": "booking-a4h-appointments.fields.paymentStatus.PAID",
                            "color": { "palette": "success" },
                            "fontWeight": "semibold"
                          },
                          "TO_PAY": {
                            "text": "booking-a4h-appointments.fields.paymentStatus.TO_PAY",
                            "color": { "palette": "warning" },
                            "fontWeight": "semibold"
                          }
                        }
                      },
                      {
                        "key": "locationDetails.department",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.department.label"
                        }
                      },
                      {
                        "key": "location.name",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.location.label"
                        }
                      },
                      {
                        "key": "hint",
                        "type": "text",
                        "hideIfEmpty": true,
                        "margin": { "top": "1rem" },
                        "valueStyle": {
                          "fontSize": "sm",
                          "fontWeight": "semibold",
                          "color": { "palette": "primary" }
                        },
                        "label": { "text": "booking-a4h-appointments.fields.hint.label" },
                        "valueMap": {
                          "TOO-EARLY": {
                            "text": "booking-a4h-appointments.fields.hint.TOO-EARLY"
                          },
                          "PRIVACY": {
                            "text": "booking-a4h-appointments.fields.hint.PRIVACY"
                          },
                          "TO-PAY": {
                            "text": "booking-a4h-appointments.fields.hint.TO-PAY"
                          },
                          "MOBILE-PAYMENT-NOT-ALLOWED": {
                            "text": "booking-a4h-appointments.fields.hint.MOBILE-PAYMENT-NOT-ALLOWED"
                          },
                          "USER-NOT-VERIFIED": {
                            "text": "booking-a4h-appointments.fields.hint.USER-NOT-VERIFIED"
                          },
                          "UNKNOWN": {
                            "text": "booking-a4h-appointments.fields.hint.UNKNOWN"
                          },
                          "TOO-LATE": {
                            "text": "booking-a4h-appointments.fields.hint.TOO-LATE"
                          },
                          "NOT-EDITABLE": {
                            "text": "booking-a4h-appointments.fields.hint.NOT-EDITABLE"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "details",
                        "type": "route",
                        "renderAs": "button",
                        "outline": true,
                        "url": "/booking-a4h/appointments/details/:id",
                        "routeParams": { "id": "id" },
                        "disabledIf": [{ "key": "busy", "operator": "eq", "value": true }],
                        "label": {
                          "text": "booking-a4h-appointments.actions.details",
                          "fontWeight": "semibold"
                        }
                      },
                      {
                        "key": "checkIn",
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "hideIf": [{ "key": "lockCause", "operator": "eq", "value": "to-pay" }],
                        "disabledIf": [
                          { "key": "checkInDisabled", "operator": "eq", "value": true }
                        ],
                        "icon": {
                          "type": "font-awesome",
                          "name": "fa-solid fa-arrow-right",
                          "position": "after"
                        },
                        "label": {
                          "text": "booking-a4h-appointments.actions.checkIn"
                        },
                        "callback": {
                          "nameFunction": "requestCheckIn",
                          "params": ["id"]
                        }
                      },
                      {
                        "key": "payment",
                        "type": "route",
                        "renderAs": "button",
                        "outline": true,
                        "url": "/payments-a4h",
                        "hideIf": [{ "key": "lockCause", "operator": "neq", "value": "to-pay" }],
                        "icon": {
                          "type": "font-awesome",
                          "name": "fa-solid fa-arrow-right",
                          "position": "after"
                        },
                        "label": {
                          "text": "booking-a4h-appointments.actions.payment"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "accepted-appointments-cards",
              "type": "SERVICE_CARDS",
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-lg-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start",
                  "gap": "gap-2"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "center",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "titleSubtitle": {
                      "title": {
                        "key": "description",
                        "fontSize": "lg",
                        "lineHeight": "sm",
                        "margin": { "bottom": "1rem" }
                      }
                    },
                    "fields": [
                      {
                        "key": "contract",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "valueMap": {
                          "SSN": { "text": "booking-a4h-appointments.fields.contract.SSN" },
                          "SOLV": {
                            "text": "booking-a4h-appointments.fields.contract.SOLV"
                          },
                          "LP": {
                            "text": "booking-a4h-appointments.fields.contract.LP"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.contract.label"
                        }
                      },
                      {
                        "key": "scheduledOn",
                        "type": "date",
                        "format": "EEEE dd MMM yyyy - HH:mm",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "valueStyle": { "fontWeight": "bold" },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.scheduledOn.label"
                        }
                      },
                      {
                        "key": "paymentStatus",
                        "type": "badge",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.paymentStatus.label"
                        },
                        "badgeMap": {
                          "PAID": {
                            "text": "booking-a4h-appointments.fields.paymentStatus.PAID",
                            "color": { "palette": "success" },
                            "fontWeight": "semibold"
                          },
                          "TO_PAY": {
                            "text": "booking-a4h-appointments.fields.paymentStatus.TO_PAY",
                            "color": { "palette": "warning" },
                            "fontWeight": "semibold"
                          }
                        }
                      },
                      {
                        "key": "locationDetails.department",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.department.label"
                        }
                      },
                      {
                        "key": "location.name",
                        "type": "text",
                        "rowSize": { "key": { "basis": "40%" }, "value": { "basis": "60%" } },
                        "label": {
                          "fontWeight": "bold",
                          "text": "booking-a4h-appointments.fields.location.label"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "details",
                        "type": "route",
                        "renderAs": "button",
                        "outline": true,
                        "url": "/booking-a4h/appointments/details/:id",
                        "routeParams": { "id": "id" },
                        "disabledIf": [{ "key": "busy", "operator": "eq", "value": true }],
                        "label": {
                          "text": "booking-a4h-appointments.actions.details",
                          "fontWeight": "semibold"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "appointmentsError",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "booking-a4h-appointments.message.error.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "booking-a4h-appointments.message.error.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "booking-a4h-appointments.message.error.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": { "palette": "danger" },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "appointmentsNotFound",
      "className": "",
      "layout": { "direction": "column", "align": "center", "justify": "center", "gap": "gap-2" },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "booking-a4h-appointments.message.notFound.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "booking-a4h-appointments.message.notFound.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": { "palette": "warning" },
          "lineHeight": "normal"
        }
      }
    }
  }
}
