{
  "name": "departments-units.name",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "title": {
      "text": "departments-units.breadcrumb.title"
    },
    "subTitle": {
      "text": "departments-units.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "departments-units.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "departments-units.breadcrumb.items.departments",
        "routerLink": "/departments"
      },
      {
        "name": "departments-units.breadcrumb.items.department",
        "routerLink": ""
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "unit-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "start",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "title",
                        "fontSize": "lg",
                        "fontWeight": "bold",
                        "className": "w-75",
                        "color": {
                          "palette": "black"
                        },
                        "lineHeight": "md"
                      },
                      "imageBlockConfig": {
                        "id": "departmentImg",
                        "className": "",
                        "layout": {
                          "direction": "column",
                          "align": "center",
                          "justify": "center",
                          "gap": "gap-2"
                        },
                        "clickable": false,
                        "image": {
                          "type": "url",
                          "value": "assets/images/doctor.png",
                          "decorative": true,
                          "alt": "departments-units.image.alt"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "pavilion",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "normal",
                          "text": "departments-units.fields.pavilion"
                        }
                      },
                      {
                        "key": "manager",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "normal",
                          "text": "departments-units.fields.manager"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "viewUnit",
                        "label": {
                          "text": "departments-units.actions.viewUnit.label",
                          "fontWeight": "bold"
                        },
                        "type": "callback",
                        "renderAs": "link",
                        "icon": {
                          "type": "font-awesome",
                          "name": "fa-solid fa-arrow-right",
                          "position": "after"
                        },
                        "callback": {
                          "nameFunction": "viewUnit",
                          "params": ["title"]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
