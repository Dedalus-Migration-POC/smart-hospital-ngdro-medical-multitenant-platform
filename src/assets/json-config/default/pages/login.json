{
  "id": "/login",
  "name": "login.name",
  "route": "/login",
  "backgroundColor": "#ecf1f9",
  "sections": [
    {
      "id": "login-section",
      "areas": {
        "layout": {
          "direction": ["column", "md-row"],
          "gap": "gap-5",
          "align": "start"
        },
        "start": {
          "size": {
            "basis": "50%"
          },
          "layout": {
            "direction": "column",
            "gap": "gap-3",
            "align": "start",
            "wrap": "nowrap"
          },
          "items": [
            {
              "id": "auth-text",
              "type": "TEXT",
              "enabled": true,
              "props": {
                "id": "auth-title",
                "text": "login.title",
                "headingTag": "h1",
                "fontSize": "xxl",
                "fontWeight": "semibold",
                "textDecoration": "none",
                "lineHeight": "sm",
                "margin": {
                  "top": "50px",
                  "bottom": "20px"
                },
                "color": {
                  "palette": "primary"
                }
              }
            },
            {
              "id": "auth-text-info",
              "type": "TEXT",
              "enabled": true,
              "props": {
                "id": "auth-into",
                "text": "login.description",
                "fontSize": "md",
                "fontWeight": "normal",
                "textDecoration": "none",
                "color": {
                  "palette": "black"
                }
              }
            }
          ]
        },
        "end": {
          "size": {
            "basis": "50%",
            "width": "100%"
          },
          "layout": {
            "direction": "row",
            "gap": "gap-2",
            "align": "center",
            "justify": "center",
            "wrap": "nowrap"
          },
          "items": [
            {
              "id": "auth-card",
              "type": "AUTH_METHODS",
              "className": "w-100 mt-3 mb-4",
              "enabled": true,
              "props": {
                "id": "auth-methods",
                "isDarkTheme": false,
                "isCard": false,
                "isVertical": false,
                "authMethods": [
                  {
                    "type": "SPID",
                    "title": "login.authMethods.spid.title",
                    "description": "login.authMethods.spid.description",
                    "button": {
                      "text": "login.authMethods.spid.button",
                      "showIcon": true,
                      "align": "start"
                    },
                    "config": {
                      "spidConfigUa": false,
                      "testProvider": {
                        "dev": {
                          "enable": true,
                          "name": "spid-test"
                        },
                        "test": {
                          "enable": true,
                          "name": "spid-test"
                        },
                        "prod": {
                          "enable": false,
                          "name": ""
                        }
                      },
                      "prefixProvider": {
                        "dev": "provaDev-",
                        "test": "provaTest-",
                        "prod": "provaProd-"
                      },
                      "returnUrl": null
                    }
                  },
                  {
                    "type": "CIE",
                    "title": "login.authMethods.cie.title",
                    "description": "login.authMethods.cie.description",
                    "button": {
                      "text": "login.authMethods.cie.button",
                      "showIcon": true,
                      "align": "start"
                    },
                    "config": {
                      "providerId": {
                        "dev": {
                          "enable": true,
                          "name": "cie-test"
                        },
                        "test": {
                          "enable": true,
                          "name": "cie-test"
                        },
                        "prod": {
                          "enable": false,
                          "name": "cie-tenant"
                        }
                      },
                      "returnUrl": null
                    }
                  },
                  {
                    "type": "MYID",
                    "title": "login.authMethods.myid.title",
                    "description": "login.authMethods.myid.description",
                    "button": {
                      "text": "login.authMethods.myid.button",
                      "showIcon": true,
                      "align": "start"
                    },
                    "config": {
                      "returnUrl": null
                    }
                  },
                  {
                    "type": "LOCAL",
                    "title": "login.authMethods.local.title",
                    "description": "login.authMethods.local.description",
                    "button": {
                      "text": "login.authMethods.local.button",
                      "showIcon": false,
                      "align": "center"
                    },
                    "config": {
                      "otp": {
                        "buttons": {
                          "align": "center",
                          "confirm": {
                            "text": "login.authMethods.local.config.otp.buttons.confirm"
                          },
                          "back": {
                            "text": "login.authMethods.local.config.otp.buttons.back",
                            "showIcon": true
                          }
                        }
                      },
                      "resetPassword": {
                        "text": "login.authMethods.local.config.resetPassword.text",
                        "link": {
                          "text": "login.authMethods.local.config.resetPassword.link",
                          "url": "/reset-password",
                          "external": false,
                          "style": {
                            "mode": "bootstrap",
                            "palette": "primary",
                            "textStyle": {
                              "fontWeight": "semibold",
                              "textDecoration": "underline"
                            }
                          }
                        }
                      },
                      "registration": {
                        "text": "login.authMethods.local.config.registration.text",
                        "link": {
                          "text": "login.authMethods.local.config.registration.link",
                          "url": "/credentials-registration",
                          "external": false,
                          "style": {
                            "mode": "bootstrap",
                            "palette": "primary",
                            "textStyle": {
                              "fontWeight": "semibold",
                              "textDecoration": "underline"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
