{
  "name": "user-profile.name",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "backgroundColor": "#e6e8ea",
    "color": "#333333",
    "title": {
      "text": "user-profile.breadcrumb.title"
    },
    "subTitle": {
      "text": "user-profile.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "user-profile.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "user-profile.breadcrumb.items.profile",
        "routerLink": "/user-profile"
      }
    ]
  },
  "breadcrumbRegistration": {
    "backgroundColor": "#e6e8ea",
    "color": "#333333",
    "title": {
      "text": "user-profile.breadcrumbRegistration.title"
    },
    "subTitle": {
      "text": "user-profile.breadcrumbRegistration.subTitle"
    },
    "items": [
      {
        "name": "user-profile.breadcrumbRegistration.items.home",
        "routerLink": "/"
      },
      {
        "name": "user-profile.breadcrumbRegistration.items.profile",
        "routerLink": "/user-profile"
      }
    ]
  },
  "sections": [
    {
      "title": "user-profile.sections.account.title",
      "readOnly": true,
      "areas": {
        "center": {
          "items": [
            {
              "id": "account-details-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": ["column"],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "fiscalCode",
                    "type": "text",
                    "disabled": true,
                    "inputClass": "form-control text-uppercase",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.account.fields.fiscalCode"
                  },
                  {
                    "id": "firstName",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.account.fields.firstName"
                  },
                  {
                    "id": "lastName",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.account.fields.lastName"
                  },
                  {
                    "id": "date_of_birth",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.account.fields.dateOfBirth"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": "user-profile.sections.domicile.title",
      "subTitle": "user-profile.sections.domicile.subTitle",
      "areas": {
        "center": {
          "items": [
            {
              "id": "domicile-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "address",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": "user-profile.sections.domicile.fields.address",
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "id": "city",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": "user-profile.sections.domicile.fields.city",
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "id": "postal_code",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": "user-profile.sections.domicile.fields.postalCode",
                    "validators": [
                      {
                        "type": "cap"
                      }
                    ]
                  },
                  {
                    "id": "province",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": "user-profile.sections.domicile.fields.province",
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": "user-profile.sections.contacts.title",
      "subTitle": "user-profile.sections.contacts.subTitle",
      "areas": {
        "center": {
          "items": [
            {
              "id": "contacts-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "email",
                    "type": "email",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.contacts.fields.email",
                    "validators": [
                      {
                        "type": "required"
                      },
                      {
                        "type": "email"
                      }
                    ]
                  },
                  {
                    "id": "phone_number",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": "user-profile.sections.contacts.fields.phoneNumber",
                    "validators": [
                      {
                        "type": "phone_number"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "consents": {
    "title": "user-profile.consents.title",
    "subTitle": "user-profile.consents.subTitle"
  },
  "submitButton": {
    "label": "user-profile.submitButton.label"
  }
}
