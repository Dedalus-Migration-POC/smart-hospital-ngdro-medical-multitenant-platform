{
  "id": "/credentials-registration",
  "name": { "it": "Registrazione", "en": "Registration" },
  "route": "/credentials-registration",
  "meta": { "title": { "it": "Registrazione", "en": "Registration" } },
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "backgroundColor": "#e6e8ea",
    "color": "#333333",
    "title": { "text": { "it": "Registrazione", "en": "Registration" } },
    "items": [
      { "name": { "it": "Home", "en": "Home" }, "routerLink": "/" },
      {
        "name": { "it": "Registrazione", "en": "Registration" },
        "routerLink": "/credentials-registration"
      }
    ]
  },
  "sections": [
    {
      "title": { "it": "Dati account", "en": "Account details" },
      "areas": {
        "center": {
          "items": [
            {
              "id": "registration-account-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-3"
                },
                "fields": [
                  {
                    "id": "firstName",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Nome", "en": "First name" },
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "Il nome e obbligatorio",
                        "en": "First name is required"
                      },
                      "backend": { "it": "Nome non valido", "en": "Invalid first name" }
                    }
                  },
                  {
                    "id": "lastName",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Cognome", "en": "Last name" },
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "Il cognome e obbligatorio",
                        "en": "Last name is required"
                      },
                      "backend": { "it": "Cognome non valido", "en": "Invalid last name" }
                    }
                  },
                  {
                    "id": "fiscalCode",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Codice fiscale", "en": "Fiscal code" },
                    "required": true,
                    "inputClass": "form-control text-uppercase",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }, { "type": "taxCode" }],
                    "errorMessages": {
                      "required": {
                        "it": "Il codice fiscale e obbligatorio",
                        "en": "Fiscal code is required"
                      },
                      "validateFiscalCode": {
                        "it": "Codice fiscale non valido",
                        "en": "Invalid fiscal code"
                      },
                      "backend": { "it": "Codice fiscale non valido", "en": "Invalid fiscal code" }
                    }
                  },
                  {
                    "id": "email",
                    "type": "email",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Email", "en": "Email" },
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }, { "type": "email" }],
                    "errorMessages": {
                      "required": { "it": "L'email e obbligatoria", "en": "Email is required" },
                      "email": { "it": "Email non valida", "en": "Invalid email" },
                      "backend": { "it": "Email non valida", "en": "Invalid email" }
                    }
                  },
                  {
                    "id": "password",
                    "type": "password",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Password", "en": "Password" },
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La password e obbligatoria",
                        "en": "Password is required"
                      },
                      "backend": { "it": "Password non valida", "en": "Invalid password" }
                    }
                  },
                  {
                    "id": "repeatPassword",
                    "type": "password",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Ripeti password", "en": "Repeat password" },
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      { "type": "passwordMatching", "value": "password" }
                    ],
                    "errorMessages": {
                      "required": {
                        "it": "Ripeti la password",
                        "en": "Repeat your password"
                      },
                      "validateMatching": {
                        "it": "Le password non coincidono",
                        "en": "Passwords do not match"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": { "it": "Dati personali e contatti", "en": "Personal details and contacts" },
      "areas": {
        "center": {
          "items": [
            {
              "id": "registration-attributes-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-3"
                },
                "fields": [
                  {
                    "id": "address",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Indirizzo", "en": "Address" },
                    "size": { "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "L'indirizzo e obbligatorio",
                        "en": "Address is required"
                      },
                      "pattern": { "it": "Indirizzo non valido", "en": "Invalid address" },
                      "backend": { "it": "Indirizzo non valido", "en": "Invalid address" }
                    }
                  },
                  {
                    "id": "province",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Provincia", "en": "Province" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La provincia e obbligatoria",
                        "en": "Province is required"
                      },
                      "pattern": { "it": "Provincia non valida", "en": "Invalid province" },
                      "backend": { "it": "Provincia non valida", "en": "Invalid province" }
                    }
                  },
                  {
                    "id": "city",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Comune", "en": "City" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": { "it": "Il comune e obbligatorio", "en": "City is required" },
                      "pattern": { "it": "Comune non valido", "en": "Invalid city" },
                      "backend": { "it": "Comune non valido", "en": "Invalid city" }
                    }
                  },
                  {
                    "id": "date_of_birth",
                    "type": "date",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Data di nascita", "en": "Date of birth" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      {
                        "type": "pattern",
                        "value": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                      }
                    ],
                    "errorMessages": {
                      "required": {
                        "it": "La data di nascita e obbligatoria",
                        "en": "Date of birth is required"
                      },
                      "pattern": {
                        "it": "Data di nascita non valida",
                        "en": "Invalid date of birth"
                      },
                      "backend": {
                        "it": "Data di nascita non valida",
                        "en": "Invalid date of birth"
                      }
                    }
                  },
                  {
                    "id": "phone_number",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Telefono", "en": "Phone number" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      {
                        "type": "pattern",
                        "value": "^(\\+39)?(3[0-9][0-9]|34[7-90]|36[680]|33[3-90]|32[89])\\d{6,7}$"
                      }
                    ],
                    "errorMessages": {
                      "required": {
                        "it": "Il telefono e obbligatorio",
                        "en": "Phone number is required"
                      },
                      "pattern": {
                        "it": "Numero di telefono non valido",
                        "en": "Invalid phone number"
                      },
                      "backend": {
                        "it": "Numero di telefono non valido",
                        "en": "Invalid phone number"
                      }
                    }
                  },
                  {
                    "id": "postal_code",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "CAP", "en": "Postal code" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      { "type": "pattern", "value": "^\\d{5}$" }
                    ],
                    "errorMessages": {
                      "required": {
                        "it": "Il CAP e obbligatorio",
                        "en": "Postal code is required"
                      },
                      "pattern": {
                        "it": "Il CAP deve contenere 5 cifre",
                        "en": "Postal code must contain 5 digits"
                      },
                      "backend": { "it": "CAP non valido", "en": "Invalid postal code" }
                    }
                  },
                  {
                    "id": "municipality",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Comune di domicilio", "en": "Domicile municipality" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "Il comune di domicilio e obbligatorio",
                        "en": "Domicile municipality is required"
                      },
                      "pattern": {
                        "it": "Comune di domicilio non valido",
                        "en": "Invalid domicile municipality"
                      },
                      "backend": {
                        "it": "Comune di domicilio non valido",
                        "en": "Invalid domicile municipality"
                      }
                    }
                  },
                  {
                    "id": "domicile_province",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Provincia di domicilio", "en": "Domicile province" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La provincia di domicilio e obbligatoria",
                        "en": "Domicile province is required"
                      },
                      "pattern": {
                        "it": "Provincia di domicilio non valida",
                        "en": "Invalid domicile province"
                      },
                      "backend": {
                        "it": "Provincia di domicilio non valida",
                        "en": "Invalid domicile province"
                      }
                    }
                  },
                  {
                    "id": "domicile_nation",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Nazione di domicilio", "en": "Domicile nation" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La nazione di domicilio e obbligatoria",
                        "en": "Domicile nation is required"
                      },
                      "pattern": {
                        "it": "Nazione di domicilio non valida",
                        "en": "Invalid domicile nation"
                      },
                      "backend": {
                        "it": "Nazione di domicilio non valida",
                        "en": "Invalid domicile nation"
                      }
                    }
                  },
                  {
                    "id": "county_of_birth",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Provincia di nascita", "en": "County of birth" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "La provincia di nascita e obbligatoria",
                        "en": "County of birth is required"
                      },
                      "pattern": {
                        "it": "Provincia di nascita non valida",
                        "en": "Invalid county of birth"
                      },
                      "backend": {
                        "it": "Provincia di nascita non valida",
                        "en": "Invalid county of birth"
                      }
                    }
                  },
                  {
                    "id": "place_of_birth",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Luogo di nascita", "en": "Place of birth" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": {
                        "it": "Il luogo di nascita e obbligatorio",
                        "en": "Place of birth is required"
                      },
                      "pattern": {
                        "it": "Luogo di nascita non valido",
                        "en": "Invalid place of birth"
                      },
                      "backend": {
                        "it": "Luogo di nascita non valido",
                        "en": "Invalid place of birth"
                      }
                    }
                  },
                  {
                    "id": "gender",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": { "it": "Sesso", "en": "Gender" },
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": { "it": "Il sesso e obbligatorio", "en": "Gender is required" },
                      "pattern": { "it": "Sesso non valido", "en": "Invalid gender" },
                      "backend": { "it": "Sesso non valido", "en": "Invalid gender" }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "consents": {
    "title": { "it": "Consensi", "en": "Consents" },
    "subtitle": { "it": "", "en": "" }
  },
  "submitButton": { "label": { "it": "Registrati", "en": "Register" } },
  "messages": {
    "loading": { "it": "Caricamento", "en": "Loading" },
    "loadError": {
      "it": "Impossibile caricare i dati di registrazione.",
      "en": "Registration details could not be loaded."
    },
    "retry": { "it": "Riprova", "en": "Retry" },

    "login": { "it": "Accedi", "en": "Log in" }
  },
  "message": {
    "success": {
      "id": "registrationSuccess",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "md"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/system/resources/previews/044/600/904/non_2x/registration-successful-account-successfully-created-id-card-on-laptop-screen-concept-illustration-flat-design-simple-modern-graphic-element-for-ui-infographic-icon-vector.jpg",
        "decorative": true,
        "alt": {
          "it": "Registrazione completata",
          "en": "Registration complete"
        },
        "height": "150px"
      },
      "text": {
        "title": {
          "text": {
            "it": "Registrazione completata",
            "en": "Registration complete"
          },
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "success"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": {
            "it": "La registrazione è avvenuta con successo.",
            "en": "Registration was successful."
          },
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "success"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
