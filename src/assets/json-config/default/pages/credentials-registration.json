{
  "name": "credentials-registration.name",
  "meta": { "title": "credentials-registration.meta.title" },
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "backgroundColor": "#e6e8ea",
    "color": "#333333",
    "title": { "text": "credentials-registration.breadcrumb.title" },
    "items": [
      { "name": "credentials-registration.breadcrumb.items.home", "routerLink": "/" },
      {
        "name": "credentials-registration.breadcrumb.items.registrations",
        "routerLink": "/credentials-registration"
      }
    ]
  },
  "sections": [
    {
      "title": "credentials-registration.form.account.title",
      "areas": {
        "center": {
          "items": [
            {
              "id": "registration-account-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-3"
                },
                "fields": [
                  {
                    "id": "firstName",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.firstName.label",
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.firstName.errorMessages.required",
                      "backend": "credentials-registration.form.account.fields.firstName.errorMessages.backend"
                    }
                  },
                  {
                    "id": "lastName",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.lastName.label",
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.lastName.errorMessages.required",
                      "backend": "credentials-registration.form.account.fields.lastName.errorMessages.backend"
                    }
                  },
                  {
                    "id": "fiscalCode",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.fiscalCode.label",
                    "required": true,
                    "inputClass": "form-control text-uppercase",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }, { "type": "taxCode" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.fiscalCode.errorMessages.required",
                      "validateFiscalCode": "credentials-registration.form.account.fields.fiscalCode.errorMessages.validateFiscalCode",
                      "backend": "credentials-registration.form.account.fields.fiscalCode.errorMessages.backend"
                    }
                  },
                  {
                    "id": "date_of_birth",
                    "type": "date",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.dateOfBirth.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      {
                        "type": "pattern",
                        "value": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                      }
                    ],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.dateOfBirth.errorMessages.required",
                      "pattern": "credentials-registration.form.account.fields.dateOfBirth.errorMessages.pattern",
                      "backend": "credentials-registration.form.account.fields.dateOfBirth.errorMessages.backend"
                    }
                  },

                  {
                    "id": "password",
                    "type": "password",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.password.label",
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.password.errorMessages.required",
                      "backend": "credentials-registration.form.account.fields.password.errorMessages.backend"
                    }
                  },
                  {
                    "id": "repeatPassword",
                    "type": "password",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.account.fields.repeatPassword.label",
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      { "type": "passwordMatching", "value": "password" }
                    ],
                    "errorMessages": {
                      "required": "credentials-registration.form.account.fields.repeatPassword.errorMessages.required",
                      "validateMatching": "credentials-registration.form.account.fields.repeatPassword.errorMessages.validateMatching"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": "credentials-registration.form.address.label",
      "areas": {
        "center": {
          "items": [
            {
              "id": "registration-attributes-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-3"
                },
                "fields": [
                  {
                    "id": "address",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.address.fields.address.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.address.fields.address.errorMessages.required",
                      "pattern": "credentials-registration.form.address.fields.address.errorMessages.pattern",
                      "backend": "credentials-registration.form.address.fields.address.errorMessages.backend"
                    }
                  },
                  {
                    "id": "province",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.address.fields.province.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.address.fields.province.errorMessages.required",
                      "pattern": "credentials-registration.form.address.fields.province.errorMessages.pattern",
                      "backend": "credentials-registration.form.address.fields.province.errorMessages.backend"
                    }
                  },
                  {
                    "id": "city",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.address.fields.city.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.address.fields.city.errorMessages.required",
                      "pattern": "credentials-registration.form.address.fields.city.errorMessages.pattern",
                      "backend": "credentials-registration.form.address.fields.city.errorMessages.backend"
                    }
                  },

                  {
                    "id": "postal_code",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.address.fields.postal_code.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      { "type": "pattern", "value": "^\\d{5}$" }
                    ],
                    "errorMessages": {
                      "required": "credentials-registration.form.address.fields.postal_code.errorMessages.required",
                      "pattern": "credentials-registration.form.address.fields.postal_code.errorMessages.pattern",
                      "backend": "credentials-registration.form.address.fields.postal_code.errorMessages.backend"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": "credentials-registration.form.contacts.label",
      "areas": {
        "center": {
          "items": [
            {
              "id": "registration-contacts-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "showSubmitButton": false,
                "layoutForm": { "direction": "column", "gap": "gap-3" },
                "layoutFields": {
                  "direction": ["column", "md-row"],
                  "wrap": "wrap",
                  "gap": "gap-3"
                },
                "fields": [
                  {
                    "id": "phone_number",
                    "type": "text",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.contacts.fields.phone_number.label",
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [
                      { "type": "required" },
                      {
                        "type": "pattern",
                        "value": "^(\\+39)?(3[0-9][0-9]|34[7-90]|36[680]|33[3-90]|32[89])\\d{6,7}$"
                      }
                    ],
                    "errorMessages": {
                      "required": "credentials-registration.form.contacts.fields.phone_number.errorMessages.required",
                      "pattern": "credentials-registration.form.contacts.fields.phone_number.errorMessages.pattern",
                      "backend": "credentials-registration.form.contacts.fields.phone_number.errorMessages.backend"
                    }
                  },
                  {
                    "id": "email",
                    "type": "email",
                    "layoutField": { "direction": "column" },
                    "label": "credentials-registration.form.contacts.fields.email.label",
                    "required": true,
                    "size": { "basis": "calc(50% - 0.5rem)", "width": "100%" },
                    "validators": [{ "type": "required" }, { "type": "email" }],
                    "errorMessages": {
                      "required": "credentials-registration.form.contacts.fields.email.errorMessages.required",
                      "email": "credentials-registration.form.contacts.fields.email.errorMessages.email",
                      "backend": "credentials-registration.form.contacts.fields.email.errorMessages.backend"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "consents": {
    "title": "credentials-registration.consents.title",
    "subtitle": "credentials-registration.consents.subtitle"
  },
  "submitButton": {
    "label": "credentials-registration.submitButton.label"
  },
  "messages": {
    "loading": "credentials-registration.messages.loading",
    "loadError": "credentials-registration.messages.loadError",
    "retry": "credentials-registration.messages.retry",
    "login": "credentials-registration.messages.login"
  },
