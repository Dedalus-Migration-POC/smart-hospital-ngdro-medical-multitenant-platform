          "text": "credentials-registration.message.success.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "success"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "credentials-registration.message.success.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "success"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
