{
  "id": "/bookings",
  "name": "bookings.bookings-list.name",
  "route": "/bookings",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "title": {
      "text": "bookings.bookings-list.breadcrumb.title"
    },
    "subTitle": {
      "text": "bookings.bookings-list.breadcrumb.subTitle"
    },
    "button": {
      "text": {
        "text": "bookings.bookings-list.breadcrumb.button"
      },
      "whiteSpace": "nowrap"
    },
    "items": [
      {
        "name": "bookings.bookings-list.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "bookings.bookings-list.breadcrumb.items.bookings",
        "routerLink": "/bookings"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "bookings-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "column",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "around",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "title",
                        "fontSize": "lg",
                        "fontWeight": "bold",
                        "color": {
                          "palette": "black"
                        },
                        "lineHeight": "md"
                      },
                      "subTitle": {
                        "key": "subtitle",
                        "fontSize": "md",
                        "fontWeight": "semibold",
                        "color": {
                          "palette": "secondary"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "date",
                        "type": "date",
                        "format": "dd/MM/yyyy HH:mm",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "normal",
                          "color": {
                            "palette": "dark"
                          },
                          "lineHeight": "xxl"
                        },
                        "label": {
                          "fontWeight": "semibold",
                          "text": "bookings.bookings-list.fields.date.label"
                        }
                      },
                      {
                        "key": "prescription",
                        "type": "array",
                        "rowSize": {
                          "key": {
                            "basis": "30%"
                          },
                          "value": {
                            "basis": "70%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "normal",
                          "color": {
                            "palette": "dark"
                          },
                          "lineHeight": "md"
                        },
                        "listStyle": "comma",
                        "label": {
                          "fontWeight": "semibold",
                          "text": "bookings.bookings-list.fields.prescription.label"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "delete",
                        "label": {
                          "text": "bookings.bookings-list.actions.delete.label"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "mode": "bootstrap",
                        "palette": "danger",
                        "callback": {
                          "nameFunction": "deleteBooking",
                          "params": ["id"]
                        },
                        "disabledIf": [
                          {
                            "key": "isPreviousDate",
                            "operator": "eq",
                            "value": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "bookings.bookings-list.message.error.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "bookings.bookings-list.message.error.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "bookings.bookings-list.message.error.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "bookingsNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "bookings.bookings-list.message.notFound.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "bookings.bookings-list.message.notFound.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "bookings.bookings-list.message.notFound.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
