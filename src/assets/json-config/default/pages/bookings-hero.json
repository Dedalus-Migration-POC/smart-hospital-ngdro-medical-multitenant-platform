{
  "id": "/bookings-hero",
  "name": "jsonConfig.default.pages.bookings-hero.name",
  "route": "/bookings-hero",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": {
      "fill": {
        "hex": "#e6e8ea"
      }
    },
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "title": {
      "text": "jsonConfig.default.pages.bookings-hero.breadcrumb.title.text"
    },
    "subTitle": {
      "text": "jsonConfig.default.pages.bookings-hero.breadcrumb.subTitle.text"
    },
    "button": {
      "text": {
        "text": "jsonConfig.default.pages.bookings-hero.breadcrumb.button.text.text"
      },
      "whiteSpace": "nowrap"
    },
    "items": [
      {
        "name": "jsonConfig.default.pages.bookings-hero.breadcrumb.items.item0.name",
        "routerLink": "/"
      },
      {
        "name": "jsonConfig.default.pages.bookings-hero.breadcrumb.items.item1.name",
        "routerLink": "/bookings-hero"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "appointment-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "center",
                  "gap": "gap-2"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "around",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "descriptionList",
                        "joinWith": " / ",
                        "fontSize": "lg",
                        "lineHeight": "sm",
                        "margin": "mb-3"
                      }
                    },
                    "fields": [
                      {
                        "key": "dateTime",
                        "type": "date",
                        "format": "dd/MM/yyyy HH:mm",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "bold",
                          "color": {
                            "palette": "danger"
                          },
                          "lineHeight": "md"
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "jsonConfig.default.pages.bookings-hero.sections.item0.areas.center.items.item0.props.items.item0.fields.item0.label.text"
                        }
                      },
                      {
                        "key": "location.name",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "jsonConfig.default.pages.bookings-hero.sections.item0.areas.center.items.item0.props.items.item0.fields.item1.label.text"
                        }
                      },
                      {
                        "key": "delegateFiscalCode",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "jsonConfig.default.pages.bookings-hero.sections.item0.areas.center.items.item0.props.items.item0.fields.item2.label.text"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "goToDetails",
                        "label": {
                          "text": "jsonConfig.default.pages.bookings-hero.sections.item0.areas.center.items.item0.props.items.item0.actions.item0.label.text"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "goToDetails",
                          "params": ["id"]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "jsonConfig.default.pages.bookings-hero.message.error.image.alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "jsonConfig.default.pages.bookings-hero.message.error.text.title.text",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "jsonConfig.default.pages.bookings-hero.message.error.text.subTitle.text",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "bookingsNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "jsonConfig.default.pages.bookings-hero.message.notFound.image.alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "jsonConfig.default.pages.bookings-hero.message.notFound.text.title.text",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "jsonConfig.default.pages.bookings-hero.message.notFound.text.subTitle.text",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
