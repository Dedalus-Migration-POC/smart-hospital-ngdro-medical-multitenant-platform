{
  "name": "payments-pa-details.name",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "title": {
      "text": "payments-pa-details.breadcrumb.title"
    },
    "subTitle": {
      "text": "payments-pa-details.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "payments-pa-details.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "payments-pa-details.breadcrumb.items.payments",
        "routerLink": "/payments-pa"
      },
      {
        "name": "payments-pa-details.breadcrumb.items.details",
        "routerLink": ""
      }
    ]
  },
  "isSimplePagoPa": true,
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "payment-card",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-10 col-lg-6",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "center",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "appointments",
                        "itemKey": "description",
                        "joinWith": " / ",
                        "fontSize": "lg",
                        "lineHeight": "md",
                        "margin": "mb-3"
                      },
                      "subTitle": {
                        "key": "causale",
                        "fontSize": "md",
                        "fontWeight": "semibold",
                        "color": {
                          "palette": "secondary"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "amount",
                        "type": "text",
                        "prefix": "€ ",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "payments-pa-details.fields.amount"
                        }
                      },
                      {
                        "key": "state",
                        "type": "badge",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "payments-pa-details.fields.state.label"
                        },
                        "badgeMap": {
                          "PAYED": {
                            "text": "payments-pa-details.fields.state.badgeMap.PAYED",
                            "lineHeight": "md",
                            "color": {
                              "palette": "success"
                            }
                          },
                          "NOT_PAYED": {
                            "text": "payments-pa-details.fields.state.badgeMap.NOT_PAYED",
                            "lineHeight": "md",
                            "color": {
                              "palette": "warning"
                            }
                          },
                          "VERIFICATION": {
                            "text": "payments-pa-details.fields.state.badgeMap.VERIFICATION",
                            "lineHeight": "md",
                            "color": {
                              "palette": "danger"
                            }
                          }
                        },
                        "fallbackBadge": {
                          "text": "payments-pa-details.fields.state.fallbackBadge",
                          "fontSize": "sm",
                          "color": {
                            "palette": "secondary"
                          }
                        }
                      },
                      {
                        "key": "iuv",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "payments-pa-details.fields.iuv"
                        }
                      },
                      {
                        "key": "authorityName",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "payments-pa-details.fields.creditor"
                        }
                      },
                      {
                        "key": "taxCode",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "payments-pa-details.fields.taxCode"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "pay",
                        "label": {
                          "text": "payments-pa-details.actions.pay"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "pay",
                          "params": []
                        },
                        "hideIf": [
                          {
                            "key": "state",
                            "operator": "eq",
                            "value": "PAYED"
                          }
                        ]
                      },
                      {
                        "key": "download",
                        "label": {
                          "text": "payments-pa-details.actions.downloadPdf.label"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "downloadPdf",
                          "params": []
                        },
                        "hideIf": [
                          {
                            "key": "state",
                            "operator": "eq",
                            "value": "NOT_PAYED"
                          }
                        ],
                        "hideMessage": {
                          "text": "payments-pa-details.actions.downloadPdf.hideMessage"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "notFound": {
      "id": "paymentsNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "md"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "payments-pa-details.message.notFound.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "payments-pa-details.message.notFound.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "payments-pa-details.message.notFound.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    },
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "md"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "payments-pa-details.message.error.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "payments-pa-details.message.error.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "payments-pa-details.message.error.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
