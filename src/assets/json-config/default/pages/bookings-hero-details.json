{
  "id": "/bookings-hero/details",
  "name": "bookings-hero.booking-details.name",
  "route": "/bookings-hero/details",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": {
      "fill": {
        "hex": "#e6e8ea"
      }
    },
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "title": {
      "text": "bookings-hero.booking-details.breadcrumb.title"
    },
    "subTitle": {
      "text": "bookings-hero.booking-details.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "bookings-hero.booking-details.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "bookings-hero.booking-details.breadcrumb.items.bookings",
        "routerLink": "/bookings-hero"
      },
      {
        "name": "bookings-hero.booking-details.breadcrumb.items.details",
        "routerLink": "/bookings-hero/details"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "appointment-card",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-10 col-lg-6",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "around",
                  "gap": "gap-4"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "appointment.descriptionList",
                        "joinWith": " / ",
                        "fontSize": "lg",
                        "lineHeight": "sm",
                        "margin": "mb-3"
                      },
                      "subTitle": {
                        "key": "appointment.serviceDescriptionList",
                        "itemKey": "description",
                        "joinWith": ", ",
                        "fontSize": "md",
                        "fontWeight": "semibold",
                        "color": {
                          "palette": "secondary"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "appointment.physician.name",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.physicianName.label"
                        }
                      },
                      {
                        "key": "appointment.unitDescription",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.unitDescription.label"
                        }
                      },
                      {
                        "key": "appointment.location.address",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.locationAddress.label"
                        }
                      },
                      {
                        "key": "appointment.dateTime",
                        "type": "date",
                        "format": "dd/MM/yyyy HH:mm",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "bold",
                          "color": {
                            "palette": "danger"
                          },
                          "lineHeight": "md"
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.dateTime.label"
                        }
                      },
                      {
                        "key": "appointment.location.name",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.locationName.label"
                        }
                      },
                      {
                        "key": "appointment.delegateFiscalCode",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.delegateFiscalCode.label"
                        }
                      },
                      {
                        "key": "appointment.finalPrice",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.finalPrice.label"
                        }
                      },
                      {
                        "key": "appointment.additionalProperties.agenda_patient_text",
                        "type": "text",
                        "margin": "my-2",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "bookings-hero.booking-details.fields.agendaPatientText.label"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "print",
                        "label": {
                          "text": "bookings-hero.booking-details.actions.print"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "callback": {
                          "nameFunction": "onPrintMemo",
                          "params": []
                        }
                      },
                      {
                        "key": "email",
                        "label": {
                          "text": "bookings-hero.booking-details.actions.email"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "outline": true,
                        "callback": {
                          "nameFunction": "onSendEmailNotification",
                          "params": []
                        },
                        "hideIf": [
                          {
                            "key": "appointment.isAtMostTomorrow",
                            "operator": "eq",
                            "value": false
                          }
                        ]
                      },
                      {
                        "key": "reschedule",
                        "label": {
                          "text": "bookings-hero.booking-details.actions.reschedule"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "onReschedule",
                          "params": []
                        },
                        "hideIf": [
                          {
                            "key": "appointment.isAtMostTomorrow",
                            "operator": "eq",
                            "value": false
                          }
                        ]
                      },
                      {
                        "key": "cancel",
                        "label": {
                          "text": "bookings-hero.booking-details.actions.cancel"
                        },
                        "type": "callback",
                        "mode": "bootstrap",
                        "renderAs": "button",
                        "palette": "danger",
                        "callback": {
                          "nameFunction": "onCancel",
                          "params": []
                        },
                        "hideIf": [
                          {
                            "key": "appointment.isAtMostTomorrow",
                            "operator": "eq",
                            "value": false
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "bookings-hero.booking-details.message.error.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "bookings-hero.booking-details.message.error.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "bookings-hero.booking-details.message.error.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "bookingsNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "bookings-hero.booking-details.message.notFound.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "bookings-hero.booking-details.message.notFound.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "bookings-hero.booking-details.message.notFound.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
