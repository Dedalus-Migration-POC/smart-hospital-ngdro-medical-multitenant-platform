{
  "name": "medical-reports.name",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "itemsStyle": {
      "color": {
        "hex": "#b41919"
      }
    },
    "title": {
      "text": "medical-reports.breadcrumb.title"
    },
    "subTitle": {
      "text": "medical-reports.breadcrumb.subTitle"
    },
    "items": [
      {
        "name": "medical-reports.breadcrumb.items.home",
        "routerLink": "/"
      },
      {
        "name": "medical-reports.breadcrumb.items.reports",
        "routerLink": "/medical-reports"
      }
    ]
  },
  "infoPopup": {
    "title": "medical-reports.infoPopup.title",
    "text": "medical-reports.infoPopup.text",
    "type": "warning"
  },
  "sections": [
    {
      "id": "search-form-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4",
            "justify": "end"
          },
          "items": [
            {
              "id": "search-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "row",
                  "gap": "gap-3"
                },
                "submitButton": {
                  "label": "medical-reports.search.submitButton",
                  "layout": {
                    "align": "self-end"
                  }
                },
                "fields": [
                  {
                    "id": "typeCode",
                    "type": "select",
                    "layoutField": {
                      "direction": "column",
                      "gap": "gap-2"
                    },
                    "label": "medical-reports.search.fields.typeCode",
                    "required": false
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "reports-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "around",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "classification.practice.label",
                        "fontSize": "lg",
                        "fontWeight": "bold",
                        "color": {
                          "palette": "black"
                        },
                        "lineHeight": "md"
                      },
                      "subTitle": {
                        "key": "classification.classes.label",
                        "fontSize": "md",
                        "fontWeight": "semibold",
                        "color": {
                          "palette": "secondary"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "releaseDate",
                        "type": "date",
                        "format": "dd/MM/yyyy",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "bold",
                          "color": {
                            "palette": "danger"
                          },
                          "lineHeight": "md"
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "medical-reports.fields.releaseDate"
                        }
                      },
                      {
                        "key": "classification.healthcareFacilityType.label",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "medical-reports.fields.operatingUnit"
                        }
                      },
                      {
                        "key": "additionalInfo.expiredDate",
                        "type": "date",
                        "format": "dd/MM/yyyy",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "medical-reports.fields.expirationDate"
                        }
                      },
                      {
                        "key": "paymentStatus",
                        "type": "badge",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": "medical-reports.fields.paymentStatus.label"
                        },
                        "badgeMap": {
                          "0": {
                            "text": "medical-reports.fields.paymentStatus.badgeMap.0",
                            "lineHeight": "md",
                            "color": {
                              "palette": "danger"
                            }
                          },
                          "1": {
                            "text": "medical-reports.fields.paymentStatus.badgeMap.1",
                            "lineHeight": "md",
                            "color": {
                              "palette": "success"
                            }
                          }
                        },
                        "fallbackBadge": {
                          "text": "medical-reports.fields.paymentStatus.fallbackBadge",
                          "fontSize": "sm",
                          "color": {
                            "palette": "secondary"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "downloadPdf",
                        "label": {
                          "text": "medical-reports.actions.downloadPdf"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "downloadPdf",
                          "params": [true]
                        }
                      },
                      {
                        "key": "openPdf",
                        "label": {
                          "text": "medical-reports.actions.openPdf"
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "downloadPdf",
                          "params": [false]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "notFound": {
      "id": "reportNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": "medical-reports.message.notFound.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "medical-reports.message.notFound.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "medical-reports.message.notFound.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    },
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": "medical-reports.message.error.image-alt",
        "height": "150px"
      },
      "text": {
        "title": {
          "text": "medical-reports.message.error.title",
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": "medical-reports.message.error.subTitle",
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}
