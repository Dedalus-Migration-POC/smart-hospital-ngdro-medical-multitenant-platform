{
  "id": "/departments",
  "name": "jsonConfig.default.pages.departments.name",
  "route": "/departments",
  "breadcrumb": {
    "title": {
      "text": "jsonConfig.default.pages.departments.breadcrumb.title.text"
    },
    "subTitle": {
      "text": "jsonConfig.default.pages.departments.breadcrumb.subTitle.text"
    },
    "items": [
      {
        "name": "jsonConfig.default.pages.departments.breadcrumb.items.item0.name",
        "routerLink": "/"
      },
      {
        "name": "jsonConfig.default.pages.departments.breadcrumb.items.item1.name",
        "routerLink": "/departments"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "department-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "start"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "start",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "title",
                        "fontSize": "lg",
                        "fontWeight": "bold",
                        "color": {
                          "palette": "black"
                        },
                        "lineHeight": "md",
                        "className": "w-75"
                      },
                      "imageBlockConfig": {
                        "id": "departmentImg",
                        "className": "",
                        "layout": {
                          "direction": "column",
                          "align": "center",
                          "justify": "center",
                          "gap": "gap-2"
                        },
                        "clickable": false,
                        "image": {
                          "type": "url",
                          "value": "assets/images/doctor.png",
                          "decorative": true,
                          "alt": "jsonConfig.default.pages.departments.sections.item0.areas.center.items.item0.props.items.item0.titleSubtitle.imageBlockConfig.image.alt",
                          "height": "60px"
                        }
                      }
                    },
                    "fields": [
                      {
                        "key": "pavilion",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "normal",
                          "text": "jsonConfig.default.pages.departments.sections.item0.areas.center.items.item0.props.items.item0.fields.item0.label.text"
                        }
                      },
                      {
                        "key": "manager",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "normal",
                          "text": "jsonConfig.default.pages.departments.sections.item0.areas.center.items.item0.props.items.item0.fields.item1.label.text"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "viewUnits",
                        "label": {
                          "text": "jsonConfig.default.pages.departments.sections.item0.areas.center.items.item0.props.items.item0.actions.item0.label.text",
                          "fontWeight": "bold"
                        },
                        "type": "callback",
                        "renderAs": "link",
                        "icon": {
                          "type": "font-awesome",
                          "name": "fa-solid fa-arrow-right",
                          "position": "after"
                        },
                        "callback": {
                          "nameFunction": "viewUnits",
                          "params": [
                            "title"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}