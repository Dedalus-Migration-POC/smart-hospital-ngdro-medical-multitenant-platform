{
  "cookie": {
    "domain": ""
  },
  "palette": {
    "popup": {
      "background": "#000",
      "border": "#000",
      "link": "#ed0e12",
      "text": "#f1d600"
    },
    "button": {
      "background": "#f1d600",
      "border": "#f1d600",
      "text": "#ed0e12"
    }
  },
  "position": "bottom-left",
  "theme": "classic",
  "type": "info",
  "layout": "my-custom-layout",
  "layouts": {
    "my-custom-layout": "{{header}}{{messagelink}}{{compliance}}"
  },
  "elements": {
    "header": "<span class=\"cc-header mb-3\">{{header}}</span>",
    "messagelink": "\n      <span id=\"cookieconsent:desc\" class=\"cc-message\">{{message}}\n        <a aria-label=\"learn more about cookies\" tabindex=\"0\" class=\"cc-link\" href=\"{{cookiePolicyHref}}\" target=\"_blank\" rel=\"noopener\">{{cookiePolicyLink}}</a>,\n        <a aria-label=\"learn more about our privacy policy\" tabindex=\"1\" class=\"cc-link\" href=\"{{privacyPolicyHref}}\" target=\"_blank\" rel=\"noopener\">{{privacyPolicyLink}}</a> and our\n        <a aria-label=\"learn more about our terms of service\" tabindex=\"2\" class=\"cc-link\" href=\"{{tosHref}}\" target=\"_blank\" rel=\"noopener\">{{tosLink}}</a>\n      </span>\n      <span id=\"cookieconsent:desc\" class=\"cc-message\">{{message}}\n      <button aria-label=\"learn more about cookies\" class=\"cookie_policy_link btn btn-link p-0\" id=\"show_cookie_policy_info\" type=\"button\">{{policy}} - MODALE</button>\n    </span>\n\n    <span id=\"cookieconsent:desc\" class=\"cc-message\">{{message}}\n      <button aria-label=\"learn more about cookies\" class=\"cookie_policy_link_pdf btn btn-link p-0\" id=\"show_cookie_policy_pdf\" type=\"button\">{{policy}} - PDF</button>\n    </span>\n      "
  },
  "content": {
    "cookiePolicyLink": "Cookie Policy",
    "cookiePolicyHref": "https://cookie.com",
    "privacyPolicyLink": "Privacy Policy",
    "privacyPolicyHref": "https://privacy.com",
    "tosLink": "Terms of Service",
    "tosHref": "https://tos.com"
  },
  "customContent": {
    "header": "cookie-consent.customContent.header",
    "message": "cookie-consent.customContent.message",
    "dismiss": "cookie-consent.customContent.dismiss",
    "cookiePolicyLink": "cookie-consent.customContent.cookiePolicyLink",
    "privacyPolicyLink": "cookie-consent.customContent.privacyPolicyLink",
    "tosLink": "cookie-consent.customContent.tosLink"
  },
  "cookieConsentModal": {
    "openerId": "show_cookie_policy_info",
    "header": {
      "background": {
        "fill": {
          "hex": "#a53e3e"
        }
      },
      "padding": {
        "all": "8px"
      },
      "title": {
        "text": "cookie-consent.cookieConsentModal.header.title"
      }
    },
    "body": {
      "background": {
        "fill": {
          "hex": "#345678"
        }
      },
      "text": {
        "text": "cookie-consent.cookieConsentModal.body"
      }
    },
    "footer": {
      "actions": [
        {
          "button": {
            "mode": "bootstrap",
            "palette": "info",
            "outline": true,
            "text": {
              "text": "cookie-consent.cookieConsentModal.footer.actions.close"
            }
          }
        }
      ]
    }
  },
  "cookieConsentOpenPdf": {
    "url": "https://pdfobject.com/pdf/sample.pdf",
    "method": "GET"
  }
}
