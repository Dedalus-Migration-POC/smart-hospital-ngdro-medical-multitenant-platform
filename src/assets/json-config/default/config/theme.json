{
  "fullWidth": false,
  "colors": {
    "primary": "#6d3ccf",
    "secondary": "#6c757d",
    "success": "#198754",
    "warning": "#ffc107",
    "danger": "#dc3545",
    "info": "#0dcaf0",
    "light": "#f8f9fa",
    "dark": "#212529"
  },
  "typography": {
    "fontFamily": "Titillium Web, sans-serif",
    "fontSize": {
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "xxl": "32px"
    },
    "lineHeight": {
      "sm": 1.2,
      "md": 1.5,
      "lg": 1.6,
      "xl": 1.7,
      "xxl": 1.8
    },
    "fontWeight": {
      "normal": 400,
      "semibold": 600,
      "bold": 700
    }
  },
  "buttonsStyle": {
    "mode": "bootstrap",
    "palette": "primary",
    "border": {
      "radius": "4px"
    }
  },
  "linksStyle": {
    "mode": "bootstrap",
    "palette": "primary",
    "textStyle": {
      "textDecoration": "none"
    }
  },
  "breadcrumb": {
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "activeItemStyle": {
      "color": {
        "palette": "dark"
      },
      "fontWeight": "semibold"
    },
    "titleStyle": {
      "fontSize": "xxl",
      "fontWeight": "bold",
      "lineHeight": "sm"
    },
    "subTitleStyle": {
      "fontSize": "lg",
      "margin": {
        "bottom": "8px"
      }
    },
    "itemsContainerStyle": {
      "padding": {
        "bottom": "8px"
      },
      "margin": {
        "bottom": "0px"
      }
    },
    "containerStyle": {
      "background": {
        "fill": {
          "hex": "#e6e8ea"
        }
      },
      "padding": {
        "y": "8px"
      }
    }
  },
  "modal": {
    "centered": false,
    "shadow": "0 2px 10px 0 rgba(0, 0, 0, 0.1)",
    "backdrop": true,
    "backdropColor": "#000000",
    "backdropOpacity": 0.5,
    "keyboard": false,
    "border": {
      "width": "1px",
      "style": "solid",
      "color": {
        "hex": "#6d6464"
      },
      "radius": "4px"
    },
    "header": {
      "padding": {
        "all": "8px"
      },
      "closeButton": true
    },
    "body": {
      "padding": {
        "all": "12px"
      }
    },
    "footer": {
      "padding": {
        "all": "8px"
      },
      "actionsButtonStyle": {
        "mode": "bootstrap",
        "palette": "primary"
      }
    }
  },
  "card": {
    "container": {
      "header": {
        "titleStyle": {
          "fontSize": "lg",
          "fontWeight": "semibold",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "lg"
        },
        "subTitleStyle": {
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "dark"
          },
          "lineHeight": "md"
        }
      },
      "containerLayout": {
        "direction": "column",
        "gap": "gap-3"
      },
      "itemsLayout": {
        "direction": "column",
        "gap": "gap-2"
      },
      "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
      "actionsLayout": {
        "direction": "column",
        "gap": "gap-2",
        "align": "center"
      }
    },
    "base": {
      "background": {
        "fill": {
          "palette": "white"
        }
      },
      "border": {
        "radius": "4px"
      },
      "shadow": "0px 4px 4px 0px #00000026",
      "padding": {
        "x": "24px",
        "y": "16px"
      },
      "size": {
        "width": "100%"
      }
    },
    "mediaText": {
      "titleStyle": {
        "fontSize": "md",
        "fontWeight": "normal",
        "color": {
          "palette": "dark"
        },
        "lineHeight": "md"
      },
      "subTitleStyle": {
        "fontSize": "sm",
        "fontWeight": "normal",
        "color": {
          "palette": "secondary"
        }
      },
      "imageStyle": {
        "width": "65px",
        "height": "65px"
      }
    },
    "data": {
      "titleStyle": {
        "fontSize": "lg",
        "fontWeight": "bold",
        "color": {
          "palette": "dark"
        },
        "lineHeight": "lg"
      },
      "subTitleStyle": {
        "fontSize": "md",
        "fontWeight": "normal",
        "color": {
          "palette": "secondary"
        },
        "lineHeight": "md"
      },
      "fields": {
        "labelStyle": {
          "fontSize": "sm",
          "fontWeight": "semibold",
          "color": {
            "palette": "danger"
          }
        },
        "valueStyle": {
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "success"
          }
        }
      },
      "actions": {
        "buttonStyle": {
          "textStyle": {
            "fontSize": "md",
            "fontWeight": "semibold"
          },
          "mode": "bootstrap",
          "palette": "primary",
          "padding": {
            "x": "12px",
            "y": "8px"
          }
        },
        "linkStyle": {
          "textStyle": {
            "fontSize": "md",
            "fontWeight": "normal",
            "textDecoration": "underline"
          },
          "mode": "bootstrap",
          "palette": "primary"
        }
      }
    }
  }
}
