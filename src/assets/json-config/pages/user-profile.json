  "sections": [
    {
      "title": {
        "it": "Dati account",
        "en": "Account details"
      },
      "readOnly": true,
      "areas": {
        "center": {
          "items": [
            {
              "id": "account-details-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": [
                    "column"
                  ],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "fiscalCode",
                    "type": "text",
                    "disabled": true,
                    "inputClass": "form-control text-uppercase",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Codice Fiscale",
                      "en": "Fiscal Code"
                    }
                  },
                  {
                    "id": "firstName",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Nome",
                      "en": "First Name"
                    }
                  },
                  {
                    "id": "lastName",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Cognome",
                      "en": "Last Name"
                    }
                  },
                  {
                    "id": "date_of_birth",
                    "type": "text",
                    "disabled": true,
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Data di nascita",
                      "en": "Date of Birth"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": {
        "it": "Domicilio",
        "en": "Domicile"
      },
      "subTitle": {
        "it": "Campi obbligatori",
        "en": "Fields required"
      },
      "areas": {
        "center": {
          "items": [
            {
              "id": "domicile-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": [
                    "column",
                    "md-row"
                  ],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "address",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": {
                      "it": "Indirizzo",
                      "en": "Address"
                    },
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "id": "city",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": {
                      "it": "Città",
                      "en": "City"
                    },
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "id": "postal_code",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": {
                      "it": "CAP",
                      "en": "Postal Code"
                    },
                    "validators": [
                      {
                        "type": "cap"
                      }
                    ]
                  },
                  {
                    "id": "province",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-0"
                    },
                    "size": {
                      "basis": "calc(50% - 0.25rem)",
                      "width": "100%"
                    },
                    "label": {
                      "it": "Provincia",
                      "en": "Province"
                    },
                    "validators": [
                      {
                        "type": "text"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "title": {
        "it": "Contatti",
        "en": "Contacts"
      },
      "subTitle": {
        "it": "Campi obbligatori",
        "en": "Fields required"
      },
      "areas": {
        "center": {
          "items": [
            {
              "id": "contacts-form",
              "type": "DYNAMIC_FORM",
              "enabled": true,
              "props": {
                "layoutForm": {
                  "direction": "column",
                  "gap": "gap-3"
                },
                "layoutFields": {
                  "direction": [
                    "column",
                    "md-row"
                  ],
                  "wrap": "wrap",
                  "gap": "gap-2"
                },
                "fields": [
                  {
                    "id": "email",
                    "type": "email",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Email",
                      "en": "Email"
                    },
                    "validators": [
                      {
                        "type": "required"
                      },
                      {
                        "type": "email"
                      }
                    ]
                  },
                  {
                    "id": "phone_number",
                    "type": "text",
                    "layoutField": {
                      "direction": "column",
                      "shrink": "shrink-0",
                      "grow": "grow-1"
                    },
                    "label": {
                      "it": "Numero di telefono",
                      "en": "Phone Number"
                    },
                    "validators": [
                      {
                        "type": "phone_number"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "consents": {
    "title": {
      "it": "Consensi",
      "en": "Consents"
    },
    "subTitle": {
      "it": "Gestisci i tuoi consensi",
      "en": "Manage your consents"
    }
  },
  "submitButton": {
    "label": {
      "it": "Salva",
      "en": "Save"
    }
  }
