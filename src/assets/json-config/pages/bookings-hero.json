{
  "id": "/bookings-hero",
  "name": {
    "it": "Prenotazioni",
    "en": "Bookings"
  },
  "route": "/bookings-hero",
  "backgroundColor": "#ffffff",
  "breadcrumb": {
    "background": {
      "fill": {
        "hex": "#e6e8ea"
      }
    },
    "itemsStyle": {
      "color": {
        "hex": "#333333"
      }
    },
    "title": {
      "text": {
        "it": "Prenotazioni",
        "en": "Bookings"
      }
    },
    "subTitle": {
      "text": {
        "it": "Visualizza le prenotazioni Hero.",
        "en": "View the Hero bookings."
      }
    },
    "button": {
      "text": {
        "text": {
          "it": "Nuova prenotazione",
          "en": "New booking"
        }
      }
    },
    "items": [
      {
        "name": {
          "it": "Home",
          "en": "Home"
        },
        "routerLink": "/"
      },
      {
        "name": {
          "it": "Prenotazioni",
          "en": "Bookings"
        },
        "routerLink": "/bookings-hero"
      }
    ]
  },
  "sections": [
    {
      "id": "cards-section",
      "areas": {
        "layout": {
          "direction": "column",
          "gap": "gap-4"
        },
        "center": {
          "layout": {
            "direction": "row",
            "wrap": "wrap",
            "gap": "gap-4"
          },
          "items": [
            {
              "id": "appointment-cards",
              "type": "SERVICE_CARDS",
              "enabled": true,
              "props": {
                "itemColBootstrapClasses": "col-12 col-md-6 col-xl-4",
                "itemsLayout": {
                  "direction": "row",
                  "align": "center",
                  "gap": "gap-2"
                },
                "actionsLayout": {
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "around",
                  "gap": "gap-2"
                },
                "items": [
                  {
                    "type": "data",
                    "background": "white",
                    "titleSubtitle": {
                      "title": {
                        "key": "descriptionList",
                        "joinWith": " / ",
                        "fontSize": "lg",
                        "lineHeight": "sm",
                        "margin": "mb-3"
                      }
                    },
                    "fields": [
                      {
                        "key": "dateTime",
                        "type": "date",
                        "format": "dd/MM/yyyy HH:mm",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "valueStyle": {
                          "fontSize": "md",
                          "fontWeight": "bold",
                          "color": {
                            "palette": "danger"
                          },
                          "lineHeight": "md"
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": {
                            "it": "Data",
                            "en": "Date"
                          }
                        }
                      },
                      {
                        "key": "location.name",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": {
                            "it": "Location",
                            "en": "Location"
                          }
                        }
                      },
                      {
                        "key": "delegateFiscalCode",
                        "type": "text",
                        "rowSize": {
                          "key": {
                            "basis": "40%"
                          },
                          "value": {
                            "basis": "60%"
                          }
                        },
                        "label": {
                          "fontWeight": "bold",
                          "text": {
                            "it": "Codice fiscale delegato",
                            "en": "Delegate fiscal code"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "key": "goToDetails",
                        "label": {
                          "text": {
                            "it": "Vedi dettagli",
                            "en": "View details"
                          }
                        },
                        "type": "callback",
                        "renderAs": "button",
                        "callback": {
                          "nameFunction": "goToDetails",
                          "params": [
                            "id"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "message": {
    "error": {
      "id": "errorMessage",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://thumbs.dreamstime.com/b/icona-di-errore-16125237.jpg",
        "decorative": true,
        "alt": {
          "it": "Errore",
          "en": "Error"
        },
        "height": "150px"
      },
      "text": {
        "title": {
          "text": {
            "it": "Errore",
            "en": "Error"
          },
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": {
            "it": "Si è verificato un errore durante il recupero dei referti. Riprova più tardi.",
            "en": "An error occurred while fetching the reports. Please try again later."
          },
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "danger"
          },
          "lineHeight": "normal"
        }
      }
    },
    "notFound": {
      "id": "bookingsNotFound",
      "className": "",
      "layout": {
        "direction": "column",
        "align": "center",
        "justify": "center",
        "gap": "gap-2"
      },
      "clickable": false,
      "image": {
        "type": "url",
        "value": "https://static.vecteezy.com/ti/vettori-gratis/p1/12181008-documento-dati-file-non-trovato-concetto-illustrazione-piatto-design-vettore-eps10-moderno-grafico-elemento-per-atterraggio-pagina-vuoto-stato-ui-infografica-icona-eccetera-vettoriale.jpg",
        "decorative": true,
        "alt": {
          "it": "Prenotazioni non trovate",
          "en": "Bookings not found"
        },
        "height": "150px"
      },
      "text": {
        "title": {
          "text": {
            "it": "Prenotazioni non trovate",
            "en": "Bookings not found"
          },
          "fontSize": "xl",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        },
        "subTitle": {
          "text": {
            "it": "La tua richiesta non ha prodotto risultati.",
            "en": "Your request did not produce any results."
          },
          "fontSize": "md",
          "fontWeight": "normal",
          "color": {
            "palette": "warning"
          },
          "lineHeight": "normal"
        }
      }
    }
  }
}