{
  "cookie": {
    "domain": ""
  },
  "palette": {
    "popup": {
      "background": "#000",
      "border": "#000",
      "link": "#4075BF",
      "text": "#FFFFFF"
    },
    "button": {
      "background": "#123c73",
      "border": "transparent",
      "text": "#FFFFFF"
    }
  },
  "position": "bottom",
  "theme": "classic",
  "type": "info",
  "layout": "my-custom-layout",
  "layouts": {
    "my-custom-layout": "<div style=\"display:flex;flex-direction:column;width:100%;\">{{header}}{{messagelink}}{{compliance}}</div>"
  },
  "elements": {
    "header": "<span class=\"fs-lg\">{{header}}</span>",
    "dismiss": "<button aria-label=\"dismiss cookie message\" type=\"button\" class=\"cc-btn cc-dismiss\">{{dismiss}}</button>",
    "messagelink": "<span id=\"cookieconsent:desc\" class=\"fs-sm mb-4\">{{message}} <a aria-label=\"learn more about cookies\" href=\"{{cookiePolicyHref}}\" target=\"_blank\" rel=\"noopener\">{{cookiePolicyLink}}</a>, <a aria-label=\"learn more about our privacy policy\" href=\"{{privacyPolicyHref}}\" target=\"_blank\" rel=\"noopener\">{{privacyPolicyLink}}</a> and our <a aria-label=\"learn more about our terms of service\" href=\"{{tosHref}}\" target=\"_blank\" rel=\"noopener\">{{tosLink}}</a>. <button aria-label=\"learn more about cookies\" class=\"cookie_policy_link btn  btn-link p-0 fs-sm\" id=\"show_cookie_policy_info\" type=\"button\">{{policy}} - MODALE</button> <button aria-label=\"learn more about cookies\" class=\"cookie_policy_link_pdf btn btn-link p-0 fs-sm\" id=\"show_cookie_policy_pdf\" type=\"button\">{{policy}} - PDF</button></span>"
  },
  "content": {
    "cookiePolicyLink": "Cookie Policy",
    "cookiePolicyHref": "https://cookie.com",
    "privacyPolicyLink": "Privacy Policy",
    "privacyPolicyHref": "https://privacy.com",
    "tosLink": "Terms of Service",
    "tosHref": "https://tos.com"
  },
  "customContent": {
    "header": "cookie-consent.customContent.header",
    "message": "cookie-consent.customContent.message",
    "dismiss": "cookie-consent.customContent.dismiss",
    "cookiePolicyLink": "cookie-consent.customContent.cookiePolicyLink",
    "privacyPolicyLink": "cookie-consent.customContent.privacyPolicyLink",
    "tosLink": "cookie-consent.customContent.tosLink"
  },
  "cookieConsentModal": {
    "openerId": "show_cookie_policy_info",
    "header": {
      "background": {
        "fill": {
          "hex": "#a53e3e"
        }
      },
      "padding": {
        "all": "8px"
      },
      "title": {
        "text": "cookie-consent.cookieConsentModal.header.title"
      }
    },
    "body": {
      "background": {
        "fill": {
          "hex": "#345678"
        }
      },
      "text": {
        "text": "cookie-consent.cookieConsentModal.body"
      }
    },
    "footer": {
      "actions": [
        {
          "button": {
            "mode": "bootstrap",
            "palette": "info",
            "outline": true,
            "text": {
              "text": "cookie-consent.cookieConsentModal.footer.actions.close"
            }
          }
        }
      ]
    }
  },
  "cookieConsentOpenPdf": {
    "url": "https://pdfobject.com/pdf/sample.pdf",
    "method": "GET"
  }
}
